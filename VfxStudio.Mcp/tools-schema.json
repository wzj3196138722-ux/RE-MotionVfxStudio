    {
      "name": "motionvfx_apply",
      "description": "Apply the current document to the captured character resource. Success means the replacement request completed/was accepted; ask the user to perform the relevant action, then check status for actual new-version creation. Never claim visual confirmation without observation.",
      "inputSchema": {
        "type": "object",
