<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VfxStudio.App</RootNamespace>
    <InformationalVersion>5.0.20261017-c</InformationalVersion>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
    <PackageReference Include="Hexa.NET.ImGuizmo" Version="2.2.9" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input.Glfw" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.22.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VfxStudio.Core\VfxStudio.Core.csproj" />
    <ProjectReference Include="..\VfxStudio.Renderer\VfxStudio.Renderer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Assets\UI\**\*">
      <Link>Assets\UI\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\Assets\Lists\effect_id_common_fixed_map.json">
      <Link>Assets\Lists\effect_id_common_fixed_map.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\Assets\RuntimeEvidence\motion-efx-observed.tsv" Condition="Exists('..\Assets\RuntimeEvidence\motion-efx-observed.tsv')">
      <Link>Assets\RuntimeEvidence\motion-efx-observed.tsv</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\Assets\RuntimeEvidence\motion-state-observed.tsv" Condition="Exists('..\Assets\RuntimeEvidence\motion-state-observed.tsv')">
      <Link>Assets\RuntimeEvidence\motion-state-observed.tsv</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\Assets\RuntimeEvidence\weapon-file-coverage.tsv" Condition="Exists('..\Assets\RuntimeEvidence\weapon-file-coverage.tsv')">
      <Link>Assets\RuntimeEvidence\weapon-file-coverage.tsv</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
